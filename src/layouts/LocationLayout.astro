---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../data/site';
import { LOCATIONS, pillars } from '../data/content';

interface Props { slug: string; }
const { slug } = Astro.props;
const loc = LOCATIONS.find((l) => l.slug === slug)!;

const title = `Plumber & HVAC in ${loc.name} | ${site.name}`;
const description = `${site.name} is a plumbing, heating, and cooling contractor serving ${loc.name} and ${loc.county} for plumbing, furnaces, boilers, AC, water heaters, and gas work since 1958.`;

const breadcrumb = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: `${site.url}/service-areas/` },
    { '@type': 'ListItem', position: 3, name: loc.name, item: `${site.url}/locations/${loc.slug}/` },
  ],
});
const serviceSchema = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Service',
  serviceType: 'Plumbing, heating, cooling, and gas services',
  provider: { '@type': 'Plumber', name: site.name,  url: site.url },
  areaServed: [{ '@type': 'City', name: loc.name }, { '@type': 'AdministrativeArea', name: loc.county }],
  url: `${site.url}/locations/${loc.slug}/`,
});
---
<Base title={title} description={description} path={`/locations/${loc.slug}/`} active={loc.slug} schemaBlocks={[breadcrumb, serviceSchema]}>

  <section class="section loc-hero">
    <div class="container loc-hero__grid">
      <div class="hero__copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/service-areas/">Service Areas</a><span aria-hidden="true">/</span>
          <span aria-current="page">{loc.name}</span>
        </nav>
        <h1>Plumber &amp; HVAC in {loc.name}</h1>
        <p class="lede">{loc.blurb} Our licensed plumbers and gas-certified HVAC technicians serve {loc.name} and the surrounding {loc.county} communities from the shop on Kingston Street in {site.address.locality}.</p>
        <div class="hero__cta" style="margin-top:24px">
          <a class="btn btn-primary btn-lg" href="/contact/"><Icon name="send" size={19} /> Request a Quote</a>
          <a class="btn btn-espresso btn-lg" href="/contact/#quote"><Icon name="phone" size={19} /> Request a quote</a>
        </div>
      </div>
    </div>
  </section>

  {/* Town-specific authored prose (per the location-page anatomy: 300+ words
      true to this town). Authored in each page via the slot. */}
  <slot />

  {/* Services available in this town. */}
  <section class="section loc-svc bg-sand-2">
    <div class="container">
      <h2>Services available in {loc.name}</h2>
      <p class="lede">Every Hoffmeyer service is available in {loc.name}, from drain cleaning and water heaters to furnaces, boilers, air conditioning, and gas fireplaces.</p>
      <ul class="loc-svc__list">
        {pillars.map((p) => (
          <li>
            <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7.5 5.5 11 12 3.5" /></svg>
            <a href={`/${p.slug}/`}>{p.name}</a>
          </li>
        ))}
      </ul>
      <p style="margin-top:22px;font-size:0.95rem;color:var(--ink-soft);max-width:62ch">Licensed plumbers and gas-certified HVAC technicians serving {loc.name} and the surrounding {loc.county} communities. Permits and inspection handled on all work that requires it, with 24-hour emergency service available.</p>
    </div>
  </section>

  <section class="section bg-espresso">
    <div class="container cta-band reveal">
      <h2>Book a plumber or HVAC tech in {loc.name}</h2>
      <p class="lede">Emergency service is available day or night, and routine calls are booked from our {site.address.locality} shop.</p>
      <div class="cta-actions">
        <a class="btn btn-primary btn-lg" href="/contact/"><Icon name="send" size={19} /> Get a Quote</a>
        <a class="btn btn-cobalt-line btn-lg" href="/contact/#quote"><Icon name="phone" size={19} /> Request a quote</a>
      </div>
    </div>
  </section>

  <section class="section contact" id="contact">
    <div class="container contact__grid">
      <div class="contact__intro reveal">
        <h2>Ask about {loc.name}</h2>
        <p>Tell us what you need in {loc.name} and we will call you back, once the request and availability have been reviewed.</p>
        <a class="contact__phone" href="/contact/#quote"><Icon name="phone" size={20} /> Request a quote</a>
      </div>
      <div class="reveal d1"><QuoteForm id={`${loc.slug}-quote`} /></div>
    </div>
  </section>

</Base>
