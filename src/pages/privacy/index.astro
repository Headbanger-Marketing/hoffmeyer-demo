---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

const title = `Privacy Policy | ${site.name}`;
const description = `How ${site.name} collects, uses, and protects the personal information you share through this website.`;
const breadcrumb = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Privacy', item: `${site.url}/privacy/` },
  ],
});
---
<Base title={title} description={description} path="/privacy/" active="privacy" schemaBlocks={[breadcrumb]}>

  <section class="section">
    <div class="container pillar-detail__wrap">
      <h1>Privacy Policy</h1>
      <p class="lede">Last updated August 2026.</p>
      <div class="pillar-detail__body">
        <p>{site.name} respects your privacy. This policy explains what personal information we collect through this website, why we collect it, and how we handle it.</p>

        <h2 style="margin-top:26px">Information we collect</h2>
        <p>When you fill out a contact or quote form, we collect the details you provide, such as your name, phone number, email address, and whatever you tell us about the job. We collect this information only when you choose to submit it.</p>

        <h2 style="margin-top:26px">How we use your information</h2>
        <p>We use the information you submit to respond to your request, provide a quote, schedule service, and communicate with you about the work. We do not sell your personal information.</p>

        <h2 style="margin-top:26px">Service providers and the family of brands</h2>
        <p>Form submissions are routed through a third-party delivery service to our team. As part of the {site.partner.name} family, the information you share may be handled by affiliated companies involved in delivering service to you, all under the same standard of care.</p>

        <h2 style="margin-top:26px">Analytics</h2>
        <p>This site may use analytics to understand how visitors use the pages so we can improve them. Analytics data is aggregated and is not used to identify you personally.</p>

        <h2 style="margin-top:26px">Your choices</h2>
        <p>You can choose not to submit a form. If you have shared information with us and want it corrected or removed, contact us and we will help.</p>

        <h2 style="margin-top:26px">Contact</h2>
        <p>Questions about this policy or your information? Email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
    </div>
  </section>

</Base>
