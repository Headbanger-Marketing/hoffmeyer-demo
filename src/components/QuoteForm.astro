---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { pillars } from '../data/content';
interface Props { id?: string; defaultService?: string; compact?: boolean; }
const { id = 'quote', defaultService } = Astro.props;
const options = [...pillars.map((p) => p.name), 'Financing & rentals', 'Emergency repair', 'Maintenance', 'Something else'];
---
<form class="qcard" id={id} action={site.webhookUrl} method="POST" novalidate>
  <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <h3>Get A Free Quote</h3>
  <p class="qcard__sub">Send a few details. Jayden's Mechanical will review your request and confirm service availability.</p>
  <div class="field">
    <label for={`${id}-name`}>Name</label>
    <input id={`${id}-name`} name="name" type="text" required autocomplete="name" placeholder="Your name" />
  </div>
  <div class="field">
    <label for={`${id}-phone`}>Phone</label>
    <input id={`${id}-phone`} name="phone" type="tel" required autocomplete="tel" placeholder="(519) 555-0123" />
  </div>
  <div class="field">
    <label for={`${id}-service`}>What do you need?</label>
    <select id={`${id}-service`} name="service">
      {options.map((o) => <option value={o} selected={o === defaultService}>{o}</option>)}
    </select>
  </div>
  <div class="field">
    <label for={`${id}-msg`}>Anything else? (optional)</label>
    <textarea id={`${id}-msg`} name="message" rows="3" placeholder="Tell us about your home, your system, or the best time to call"></textarea>
  </div>
  <button class="btn btn-primary btn-lg" type="submit"><Icon name="send" size={19} /> <span class="btn__label">Get A Free Quote</span></button>
  <p class="qcard__note" role="status" aria-live="polite" aria-atomic="true">Submitting requests a follow-up. Availability and appointments are confirmed separately.</p>
  <p class="qcard__fallback">Need help? <a href="mailto:info@jaydensmechanical.com">Email Jayden's Mechanical</a>. This form is not monitored for emergencies.</p>
  <div class="qcard__done" role="status" tabindex="-1" hidden>
    <Icon name="check" size={28} />
    <h3>Request received</h3>
    <p>Your request has been accepted. Jayden's Mechanical will review it and confirm service availability and the next step.</p>
  </div>
</form>

<script>
  import "../scripts/quote-intake";
</script>
