---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { pillars } from '../data/content';
interface Props { id?: string; defaultService?: string; compact?: boolean; }
const { id = 'quote', defaultService } = Astro.props;
const options = [...pillars.map((p) => p.name), 'Financing & rentals', 'Emergency repair', 'Maintenance', 'Something else'];
---
<form class="qcard" id={id} action={site.webhookUrl} method="POST" novalidate>
  <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <h3>Request a call-back</h3>
  <p class="qcard__sub">Send your details and a callback will confirm the service request and availability.</p>
  <div class="field">
    <label for={`${id}-name`}>Name</label>
    <input id={`${id}-name`} name="name" type="text" required autocomplete="name" placeholder="Your name" />
  </div>
  <div class="field">
    <label for={`${id}-phone`}>Phone</label>
    <input id={`${id}-phone`} name="phone" type="tel" required autocomplete="tel" placeholder="(519) 555-0123" />
  </div>
  <div class="field">
    <label for={`${id}-service`}>What do you need?</label>
    <select id={`${id}-service`} name="service">
      {options.map((o) => <option value={o} selected={o === defaultService}>{o}</option>)}
    </select>
  </div>
  <div class="field">
    <label for={`${id}-msg`}>Anything else? (optional)</label>
    <textarea id={`${id}-msg`} name="message" rows="3" placeholder="Tell us about your home, your system, or the best time to call"></textarea>
  </div>
  <button class="btn btn-primary btn-lg" type="submit"><Icon name="send" size={19} /> <span class="btn__label">Request call-back</span></button>
  <p class="qcard__note">A callback will confirm availability. This form is not monitored for emergencies.</p>
  <div class="qcard__done" role="status" tabindex="-1" hidden>
    <Icon name="check" size={28} />
    <h3>Request received</h3>
    <p>Send your details with the form. A callback will confirm the service request and availability. For an immediate safety hazard, contact the appropriate emergency service.</p>
  </div>
</form>

<script>
  // Submit by fetch so the visitor never lands on the raw webhook response.
  // Wires every .qcard on the page (the component may render more than once).
  document.querySelectorAll('form.qcard').forEach((el) => {
    const form = el as HTMLFormElement;
    if (form.dataset.leadSubmitBound === 'true') return;
    form.dataset.leadSubmitBound = 'true';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const done = form.querySelector('.qcard__done') as HTMLElement | null;
      const note = form.querySelector('.qcard__note') as HTMLElement | null;
      const honey = form.querySelector('input[name="_honey"]') as HTMLInputElement | null;
      const label = (btn?.querySelector('.btn__label') || null) as HTMLElement | null;
      if (!btn || !done || btn.disabled) return;
      btn.disabled = true;
      if (label) label.textContent = 'Sending...';
      try {
        if (!honey?.value) {
          const fd = new FormData(form);
          const value = (key, fallback) => String(fd.get(key) || fd.get(fallback) || '').trim();
          const params = new URLSearchParams();
          params.set('1.3', value('1.3', 'name'));
          params.set('2', value('2', 'email'));
          params.set('4', value('4', 'phone'));
          params.set('5.1', value('5.1', 'address'));
          params.set('5.3', value('5.3', 'city'));
          params.set('5.5', value('5.5', 'postal'));
          const service = String(fd.get('service') || '').trim();
          params.set('3', (service ? 'Service: ' + service + ' | ' : '') + value('3', 'message'));
          params.set('source_url', window.location.href);
          params.set('date_created', new Date().toISOString());
          const response = await fetch(form.action, {
            method: 'POST', mode: 'cors',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
            body: params.toString(),
          });
          if (!response.ok) throw new Error('Lead intake rejected the request');
        }
        form.querySelectorAll('.field').forEach((f) => f.setAttribute('hidden', ''));
        const sub = form.querySelector('.qcard__sub') as HTMLElement | null;
        const h3 = form.querySelector('.qcard > h3') as HTMLElement | null;
        if (h3) h3.hidden = true;
        if (sub) sub.hidden = true;
        btn.hidden = true;
        if (note) note.hidden = true;
        done.hidden = false;
        done.focus();
      } catch {
        btn.disabled = false;
        if (label) label.textContent = 'Try again';
        if (note) note.textContent = 'We could not submit your request. Your details are still here; please try again or use the contact email.';
      }
    });
  });
</script>
